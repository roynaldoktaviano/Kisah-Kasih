# Salin file ini menjadi .env.local lalu isi nilainya.
# JANGAN isi nilai asli di file ini — file ini ikut ter-commit ke git.

# Connection string dari Neon (Dashboard → Connect). Pakai yang "pooled" (ada -pooler di host).
# Kosongkan saat development → otomatis memakai database lokal PGlite (.data/pglite).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Akun admin pertama (dibuat otomatis saat database masih kosong).
ADMIN_LOGIN="admin@domainmu.com"
ADMIN_PASSWORD="ganti-dengan-password-kuat"

# Alamat situs untuk link undangan di pesan WhatsApp (opsional; default = domain yang sedang dibuka)
SITE_URL="https://domainmu.com"
